# Django Secret Key (Generate a secure unique key for production)
SECRET_KEY=django-insecure-jhaztaxi-super-secret-key-change-in-production-2026

# Debug Mode: True for development, False for production
DEBUG=True

# Database URL:
# For Local Dev: If left blank or unset, Django defaults to local SQLite for instant testing
# For PostgreSQL (Dev or Render):
# DATABASE_URL=postgres://username:password@hostname:5432/database_name
DATABASE_URL=

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com

# Frontend URL(s) allowed for CORS (comma-separated)
FRONTEND_URL=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000,https://jhaztaxi.vercel.app

# Optional Map API key if using custom tiles/geocoding (Leaflet & OSRM work out-of-the-box for free)
MAP_API_KEY=
